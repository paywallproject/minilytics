# Every static file. The dashboard can't be framed by other sites (clickjacking); nothing is MIME-sniffed.
# No script/style restrictions here: the app uses an inline theme script, map tiles and Google avatars.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'

# Short, so tracker fixes reach every browser within minutes (it is revalidated cheaply after that).
/js/script.js
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

# Fingerprint's open-source bot detector (BotD), loaded by the tracker on a new visit's first page; cross-origin
# dynamic import needs CORS.
/js/botd.js
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400

# Vite file names change with every build, so these can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/landing/*
  Cache-Control: public, max-age=86400

/sponsors/*
  Cache-Control: public, max-age=86400

/site.webmanifest
  Content-Type: application/manifest+json

/avatars/*
  Cache-Control: public, max-age=604800
